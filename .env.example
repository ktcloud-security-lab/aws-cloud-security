# 견본. 복사해서 .env 로 만들고 값을 채운다:  cp .env.example .env
# 실제 값은 .env 에만 적고, .env 는 git 에 올리지 않는다.
DB_HOST=127.0.0.1          # 서버에서는 DB EC2 사설 IP
DB_PORT=3307               # 로컬 Docker MySQL. 서버 MySQL 기본은 3306
DB_USER=board              # 로컬 Docker 기본 테스트는 root
DB_PASSWORD=
DB_NAME=board
SECRET_KEY=                # python -c "import secrets;print(secrets.token_hex(32))" 결과를 넣는다
COOKIE_SECURE=1            # HTTPS 로 서비스할 때만. 로컬 HTTP 는 이 줄을 비우거나 지운다
PORT=5000
